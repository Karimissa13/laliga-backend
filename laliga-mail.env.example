# LaLiga Academy — email settings
# 1. Copy this file next to START-LALIGA.bat and rename it to:  laliga-mail.env
# 2. Fill in your mailbox details (ask IT / your email provider for the SMTP settings)
# 3. Run START-LALIGA.bat again
#
# Microsoft 365:      MAIL_HOST=smtp.office365.com   MAIL_PORT=587  MAIL_SECURE=false
# Google Workspace:   MAIL_HOST=smtp.gmail.com       MAIL_PORT=587  MAIL_SECURE=false  (use an App Password)
#
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
