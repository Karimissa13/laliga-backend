{
  "name": "laliga-academy-backend",
  "version": "0.1.0",
  "description": "LaLiga Academy Abu Dhabi \u2014 operations & administration backend (NestJS + PostgreSQL)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "db:reset": "ts-node -r tsconfig-paths/register src/database/reset.ts",
    "test": "jest --config test/jest.config.js",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "db:setup": "npm run db:seed && npm run db:seed:academy",
    "migrate": "ts-node -r tsconfig-paths/register src/migration/import-legacy.ts",
    "db:seed:academy": "ts-node -r tsconfig-paths/register src/database/seed-academy.ts",
    "db:fresh": "npm run db:reset && npm run db:setup",
    "test:fixtures": "ts-node -r tsconfig-paths/register test/fixtures/demo-fixtures.ts",
    "db:migrate": "node dist/database/migrate.js",
    "db:migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "build:vercel": "nest build && node dist/database/migrate.js && node dist/database/seed.js && node dist/database/seed-academy.js && node dist/database/demo-data.js",
    "db:migration:check": "typeorm-ts-node-commonjs migration:generate src/database/migrations/Pending -d src/database/data-source.ts --check"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "helmet": "^7.2.0",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "engines": {
    "node": "24.x"
  }
}
